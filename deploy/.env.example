# Скопируй в deploy/.env (он в .gitignore) — compose читает его сам при любой команде.
# Создать с готовым токеном: sh tools/wravler/init-token.sh

# Токен API платформы для wravler. Тот же, что в ~/.config/wravler/token.
WRAVLER_TOKEN=

# Корневой домен платформы: воркеры на <имя>.<ROOT_DOMAIN>, API на api.<ROOT_DOMAIN>.
# В DNS нужны записи ROOT_DOMAIN и *.ROOT_DOMAIN на Caddy (wildcard-сертификат — через DNS-01).
ROOT_DOMAIN=workers.example.com

# Бэкап /data (реестр воркеров и данные Durable Objects)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Куда класть архивы: имя named volume или абсолютный путь на сервере (например /opt/backups/workerd).
# Для абсолютного пути папка должна быть доступна на запись uid 10001.
BACKUP_TARGET=workerd_backups

# Лимиты контейнера каждого воркера (worker-<имя>): память в МБ и доля CPU
RUNNER_MEMORY_MB=256
RUNNER_CPUS=1

# Постоянные IP платформы и egress в сети workerd_internal (в её подсети и свободны)
PLATFORM_IP=10.0.3.250
EGRESS_IP=10.0.3.251
