# Скопируй в deploy/.env (он в .gitignore) — compose читает его сам при любой команде.
# Создать с готовым токеном: sh tools/wravler/init-token.sh

# Токен API платформы для wravler. Тот же, что в ~/.config/wravler/token.
WRAVLER_TOKEN=

# Бэкап /data (реестр воркеров и данные Durable Objects)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Куда класть архивы: имя named volume или абсолютный путь на сервере (например /opt/backups/workerd).
# Для абсолютного пути папка должна быть доступна на запись uid 10001.
BACKUP_TARGET=workerd_backups
